<Window x:Class="IsMySteamSafe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="我的 Steam 安全吗？" Width="1220" Height="820" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17324D" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="#26A69A">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" FontWeight="Bold" Foreground="White" Text="S" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="White" Text="我的 Steam 安全吗？" />
                    <TextBlock Margin="0,3,0,0" Foreground="#CAD8E2" Text="只回答 Steam 有没有被动过手脚，不替代杀毒软件" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,5" CornerRadius="12" Background="#294861">
                        <TextBlock Foreground="#E6F5F2" FontWeight="SemiBold" Text="v0.2.2 EVIDENCE" />
                    </Border>
                    <Border Margin="10,0,0,0" Padding="10,5" CornerRadius="12" Background="#294861">
                        <TextBlock Foreground="#CAD8E2" Text="本地 · 只读 · 不上传" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" TabStripPlacement="Left" Margin="0" Padding="0">
            <TabItem AutomationProperties.Name="安全体检">
                <TabItem.Header>
                    <StackPanel Width="164" Margin="2">
                        <TextBlock FontSize="15" Text="安全体检" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="Normal" Foreground="#7A8C98" Text="Steam 客户端审计" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,22,28,28" MaxWidth="1040" HorizontalAlignment="Left">
                        <Border x:Name="HeroBorder" Style="{StaticResource Card}" Background="#E6F5F2" BorderBrush="#B7DED8" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="HeroEyebrowText" Foreground="#177D76" FontWeight="SemiBold" Text="准备就绪" />
                                    <TextBlock x:Name="HeroTitleText" Margin="0,8,0,0" FontSize="26" FontWeight="SemiBold" Text="现在的 Steam，还是原来的 Steam 吗？" />
                                    <TextBlock x:Name="HeroDescriptionText" Margin="0,9,0,0" MaxWidth="700" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="#475467" Text="一次按需体检会核对客户端 DLL、steamui 关键逻辑、客服路由、启动链与运行模块。通常在数秒到十几秒内完成。" />
                                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                                        <Button x:Name="StartAuditButton" Style="{StaticResource PrimaryButton}" Content="开始本地体检" Click="StartAudit_Click"
                                                AutomationProperties.Name="开始本地体检" />
                                        <Button x:Name="CancelAuditButton" Content="取消" IsEnabled="False" Click="CancelAudit_Click" />
                                        <Button x:Name="ExportButton" Content="导出报告" IsEnabled="False" Click="Export_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="HeroIconBorder" Grid.Column="1" Width="92" Height="92" Margin="24,0,0,0" CornerRadius="46" Background="#FFFFFF" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroGlyphText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="39" FontWeight="SemiBold" Foreground="#177D76" Text="?" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource Card}" Padding="18,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ProgressStageText" FontWeight="SemiBold" Text="等待开始" />
                                    <TextBlock x:Name="ProgressDetailText" Margin="0,4,0,10" Foreground="{StaticResource MutedBrush}" Text="不会修改 Steam、注册表或系统设置" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="AuditProgressBar" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>
                                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" Text="0%" />
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="15,12" CornerRadius="11" Background="#FFFDF6" BorderBrush="#F3D6A2" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="ClientModsCheckBox" Content="我主动安装过 Millennium、Steam 客户端插件或美化注入工具" />
                                <TextBlock Margin="24,4,0,0" Foreground="#7A5A2B" TextWrapping="Wrap"
                                           Text="勾选后，匹配到已声明的合法加载器会降为“需要核对”，但不会对白名单外插件自动放行。游戏 MOD 与 ReShade 不需要勾选。" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,24,0,10" FontSize="18" FontWeight="SemiBold" Text="这次检查了什么" />
                        <ItemsControl x:Name="CheckCardsControl" ItemsSource="{Binding CheckCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="238" MinHeight="138" Margin="0,0,10,10" Padding="15" CornerRadius="12"
                                            BorderThickness="1" BorderBrush="{Binding Accent}" Background="{Binding Tint}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <Border HorizontalAlignment="Right" Padding="7,3" CornerRadius="9" Background="White">
                                                    <TextBlock FontSize="11" Foreground="{Binding Accent}" Text="{Binding Status}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{Binding Accent}" Text="{Binding Priority}" />
                                            <TextBlock Margin="0,7,0,0" Foreground="#475467" TextWrapping="Wrap" LineHeight="18" Text="{Binding Summary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="EmptyResultsPanel" Margin="0,8,0,0" Style="{StaticResource Card}" Padding="26">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyResultsTitleText" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="结果会写成人能看懂的话" />
                                <TextBlock x:Name="EmptyResultsDescriptionText" Margin="0,8,0,0" MaxWidth="600" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                           Text="不会只丢给你“高危”两个字。每条结果都会说明发现了什么、它意味着什么，以及下一步交给谁处理。" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="ResultsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="10,8,10,10" FontSize="16" FontWeight="SemiBold" Text="证据与提示" />
                                    <ListBox x:Name="FindingsList" ItemsSource="{Binding Findings}" BorderThickness="0" Background="Transparent"
                                             SelectionChanged="FindingsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,7" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" CornerRadius="9" Background="{Binding Tint}" BorderBrush="{Binding Accent}" BorderThickness="1,0,0,0">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock FontSize="11" Foreground="{Binding Accent}" FontWeight="SemiBold" Text="{Binding Level}" />
                                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="#667085" Text="{Binding Priority}" />
                                                        </Grid>
                                                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border x:Name="DetailLevelBorder" HorizontalAlignment="Left" Padding="9,4" CornerRadius="10" Background="#F2F4F7">
                                            <TextBlock x:Name="DetailLevelText" FontSize="11" FontWeight="SemiBold" Text="选择一项" />
                                        </Border>
                                        <TextBlock x:Name="DetailTitleText" Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="从左侧选择一条证据" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Foreground="#344054" Text="发现什么" />
                                        <TextBlock x:Name="DetailWhatText" TextWrapping="Wrap" LineHeight="20" Foreground="#475467" />
                                        <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Foreground="#344054" Text="意味着什么" />
                                        <TextBlock x:Name="DetailMeaningText" TextWrapping="Wrap" LineHeight="20" Foreground="#475467" />
                                        <Border Margin="0,17,0,0" Padding="14" CornerRadius="10" Background="#EAF7F5">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Foreground="#0F5F5A" Text="建议怎么做" />
                                                <TextBlock x:Name="DetailRecommendationText" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Foreground="#344054" Text="路径 / 位置" />
                                        <TextBox x:Name="DetailTargetText" IsReadOnly="True" BorderThickness="0" Padding="0" TextWrapping="Wrap" Background="Transparent" />
                                        <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Foreground="#344054" Text="证据字段" />
                                        <TextBox x:Name="DetailEvidenceText" IsReadOnly="True" BorderThickness="0" Padding="0" TextWrapping="Wrap" Background="Transparent" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="红信判真伪">
                <TabItem.Header>
                    <StackPanel Width="164" Margin="2">
                        <TextBlock FontSize="15" Text="红信判真伪" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="Normal" Foreground="#7A8C98" Text="三秒看清实际域名" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="先看域名，再决定要不要相信" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21"
                                   Text="粘贴“联系客服”按钮的实际地址，或包含该地址的一小段页面源码。本工具只解析文本，不会打开链接，也不会进行 DNS 查询。" />
                        <Border Margin="0,18,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="链接或页面片段" />
                                <TextBox x:Name="UrlInputTextBox" Margin="0,9,0,0" Height="132" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap" AutomationProperties.Name="需要核对的客服链接" />
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Content="只在本地检查" Click="InspectUrl_Click" />
                                    <Button Content="清空" Click="ClearUrl_Click" />
                                    <Button Content="复制官方客服地址" Click="CopyOfficialSupport_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="UrlSummaryBorder" Margin="0,14,0,0" Style="{StaticResource Card}" Background="#F2F4F7">
                            <StackPanel>
                                <TextBlock x:Name="UrlSummaryEyebrow" FontWeight="SemiBold" Foreground="#667085" Text="等待检查" />
                                <TextBlock x:Name="UrlSummaryText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" Text="实际主机会在这里显示" />
                                <TextBlock x:Name="UrlSummaryNoteText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#475467"
                                           Text="官方客服主机应为 help.steampowered.com，看起来相似的前缀、@ 符号或多一级后缀都不算。" />
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="UrlResultsControl" Margin="0,12,0,0" ItemsSource="{Binding UrlResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,9" Padding="15" CornerRadius="11" Background="{Binding Tint}" BorderBrush="{Binding Accent}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="#667085" Text="实际主机" />
                                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Host}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Foreground="{Binding Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Result}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#475467" TextWrapping="Wrap" Text="{Binding Details}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,13,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="同一条提示，在手机或网页端也能看到吗？" />
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" Text="这项不单独判定木马，只帮助你评估“仅本机显示”的异常程度。" />
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <RadioButton x:Name="SyncUnknownRadio" GroupName="CloudSync" IsChecked="True" Content="还没核对" Checked="CloudSync_Changed" Margin="0,0,18,0" />
                                    <RadioButton x:Name="SyncYesRadio" GroupName="CloudSync" Content="其他设备也有" Checked="CloudSync_Changed" Margin="0,0,18,0" />
                                    <RadioButton x:Name="SyncPcOnlyRadio" GroupName="CloudSync" Content="只有这台电脑有" Checked="CloudSync_Changed" />
                                </StackPanel>
                                <TextBlock x:Name="CloudSyncGuidanceText" Margin="0,11,0,0" Padding="12" Background="#F8FAFB" TextWrapping="Wrap"
                                           Text="建议在手机 Steam App 或浏览器登录官方客服页交叉核对。不要从当前红信页面跳转。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="下一步怎么做">
                <TabItem.Header>
                    <StackPanel Width="164" Margin="2">
                        <TextBlock FontSize="15" Text="下一步怎么做" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="Normal" Foreground="#7A8C98" Text="交给专业安全软件" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24" MaxWidth="920" HorizontalAlignment="Left">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="真正的查杀，交给专业杀毒软件" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21"
                                   Text="本工具负责指出 Steam 哪里被改过，360、卡巴斯基、Windows 安全中心等专业产品负责识别与清除恶意程序。" />
                        <Border Margin="0,18,0,0" Padding="17" CornerRadius="12" Background="#FFF4E5" BorderBrush="#F4C68C" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#934A05" Text="顺序很重要：先查杀，再改密码" />
                                <TextBlock Margin="0,6,0,0" Foreground="#70400D" TextWrapping="Wrap" LineHeight="20"
                                           Text="如果窃取凭据的程序仍在运行，提前修改的新密码可能再次被读取。请先确认系统干净，再在干净设备上处理账户。" />
                            </StackPanel>
                        </Border>

                        <ItemsControl Margin="0,15,0,0">
                            <ItemsControl.Items>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#17324D"><TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="1"/></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="停止操作并断网"/><TextBlock Margin="0,4,0,0" Foreground="#667085" TextWrapping="Wrap" Text="不要继续扫码、付款或输入 Steam 凭据，退出 Steam 并暂时断开网络。"/></StackPanel></Grid></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#177D76"><TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="2"/></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="更新专业杀毒软件并全盘扫描"/><TextBlock Margin="0,4,0,0" Foreground="#667085" TextWrapping="Wrap" Text="让杀毒软件覆盖 Steam 目录、用户目录、启动项和系统盘，查杀后重启并复扫。"/></StackPanel></Grid></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#177D76"><TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="3"/></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="确认干净后，再处理账户"/><TextBlock Margin="0,4,0,0" Foreground="#667085" TextWrapping="Wrap" Text="在干净设备上修改密码、重新绑定手机令牌，并撤销其他设备授权。"/></StackPanel></Grid></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#177D76"><TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="4"/></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="从官网重装 Steam"/><TextBlock Margin="0,4,0,0" Foreground="#667085" TextWrapping="Wrap" Text="完整重装比逐个修补客户端文件更可靠。保留体检报告，恶意样本是否保留应听从安全软件建议。"/></StackPanel></Grid></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#177D76"><TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="5"/></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="核对授权、API 密钥和订单"/><TextBlock Margin="0,4,0,0" Foreground="#667085" TextWrapping="Wrap" Text="检查 Web API 密钥是否被擅自生成，并核对购买记录、市场交易与库存变化。"/></StackPanel></Grid></Border>
                            </ItemsControl.Items>
                        </ItemsControl>

                        <Border Margin="0,7,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="把关键信息带给杀毒软件" />
                                <TextBlock Margin="0,6,0,13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Text="交接清单会包含本次结论、可疑路径和 SHA-256，不包含 Steam 密码、令牌或聊天内容。" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="复制交接清单" Click="CopyHandoff_Click" />
                                    <Button Content="打开 Windows 安全中心" Click="OpenWindowsSecurity_Click" />
                                    <Button Content="打开 Steam 官方客服" Click="OpenOfficialSupport_Click" />
                                    <Button Content="打开 Steam 官方安装页" Click="OpenOfficialInstaller_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="只读取证">
                <TabItem.Header>
                    <StackPanel Width="164" Margin="2">
                        <TextBlock FontSize="15" Text="只读取证" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="Normal" Foreground="#7A8C98" Text="无需命令行的证据包" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24" MaxWidth="920" HorizontalAlignment="Left">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="事件查看器打不开，也能留下可复核证据" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21"
                                   Text="生成一个本地 ZIP：记录 Steam 审计、进程树、相关模块、当前 TCP 连接、启动链、服务、计划任务、代理/DNS、证书元数据和关键文件哈希。全程不调用 CMD 或 PowerShell。" />

                        <Border Margin="0,18,0,0" Padding="17" CornerRadius="12" Background="#EFF8FF" BorderBrush="#84CAFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#175CD3" Text="证据优先，隐私默认收敛" />
                                <TextBlock Margin="0,6,0,0" Foreground="#344054" TextWrapping="Wrap" LineHeight="20"
                                           Text="不会复制 EXE、DLL、压缩包、大型 JavaScript、证书或私钥，只保存元数据、签名、SHA-256 和少量配置文本。当前用户目录、17 位 SteamID、URL 的 u=/d= 参数会自动脱敏。" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Margin="0,15,0,0" Columns="2">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock FontWeight="SemiBold" Text="运行快照"/><TextBlock Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap" Text="PID/父 PID、映像路径与签名；Steam 和用户目录相关模块；IPv4 TCP 当前连接。"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock FontWeight="SemiBold" Text="持久化与网络"/><TextBlock Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap" Text="Run/RunOnce、Steam IFEO/SilentProcessExit、服务、任务、WinINET/WinHTTP、DNS 与 hosts。"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock FontWeight="SemiBold" Text="Steam 文件证据"/><TextBlock Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap" Text="steam.exe、steam.cfg、steamui/clientui 脚本和侧载敏感文件的大小、时间与哈希。"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock FontWeight="SemiBold" Text="覆盖说明"/><TextBlock Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap" Text="任何权限不足、上限跳过和暂未实现项都会单列，避免把“没读到”写成“没有异常”。"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Margin="0,8,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="可选：补充一个样本或解压目录" />
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Text="只枚举文件并计算哈希，不会打开程序，也不会解压归档。小于 256 KiB 的脚本或配置会收入文本快照，请在分享前检查隐私。" />
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="EvidenceFolderTextBox" IsReadOnly="True" Text="未选择（仅收集 Steam 与系统证据）" AutomationProperties.Name="补充取证目录" />
                                    <Button x:Name="ChooseEvidenceFolderButton" Grid.Column="1" Margin="9,0,0,0" Content="选择目录" Click="ChooseEvidenceFolder_Click" />
                                    <Button x:Name="ClearEvidenceFolderButton" Grid.Column="2" Margin="0" Content="清除" Click="ClearEvidenceFolder_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="EvidenceStageText" FontWeight="SemiBold" Text="等待生成" />
                                        <TextBlock x:Name="EvidenceDetailText" Margin="0,4,0,10" Foreground="{StaticResource MutedBrush}" Text="建议在异常仍可见、可疑进程仍运行时立即取证" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock x:Name="EvidencePercentText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" Text="0%" />
                                </Grid>
                                <ProgressBar x:Name="EvidenceProgressBar" Minimum="0" Maximum="100" Value="0" />
                                <WrapPanel Margin="0,15,0,0">
                                    <Button x:Name="EvidenceExportButton" Style="{StaticResource PrimaryButton}" Content="生成只读取证包 (.zip)" Click="ExportEvidence_Click" AutomationProperties.Name="生成只读取证包" />
                                    <Button x:Name="EvidenceCancelButton" Content="取消" IsEnabled="False" Click="CancelAudit_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,13,0,0" Foreground="#667085" TextWrapping="Wrap" LineHeight="20"
                                   Text="瞬时限制：已经退出的进程、已经关闭的网络连接和过去发生但未留下文件/配置的动作无法还原。取证包不是“无毒证明”，也不替代专业杀毒软件。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="边界与隐私">
                <TabItem.Header>
                    <StackPanel Width="164" Margin="2">
                        <TextBlock FontSize="15" Text="边界与隐私" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="Normal" Foreground="#7A8C98" Text="工具会做与不会做" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="边界清楚，结论才值得信任" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="v0.2.2-evidence 是 Steam 客户端本地审计器，并增加无需命令行的只读取证包。它检测篡改后的状态，不维护病毒家族特征库。" />
                        <UniformGrid Margin="0,18,0,0" Columns="2">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock FontWeight="SemiBold" Foreground="#177D76" Text="只读检查"/><TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#667085" Text="读取 Steam 文件、数字签名、关键脚本、相关进程模块与注册表配置，不会修改它们。"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock FontWeight="SemiBold" Foreground="#177D76" Text="不上传数据"/><TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#667085" Text="没有云扫描、遥测或账户采集。红信链接也只在本地解析，不进行网络请求。"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock FontWeight="SemiBold" Foreground="#B54708" Text="不主动清除"/><TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#667085" Text="没有隔离、删除、注册表写入、证书移除或 UAC 提权模块。查杀交给专业安全软件。"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock FontWeight="SemiBold" Foreground="#B54708" Text="不做绝对保证"/><TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#667085" Text="未发现已支持的篡改迹象，不代表未知攻击或整台电脑绝对安全，覆盖不足会明确标出。"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Margin="0,8,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="v0.2.2-evidence 已实现" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21"
                                           Text="P0：DLL 侧载与转发结构、steamui 客服告警/游戏启动/隐藏地址栏语义、直接与局部变量客服路由；P1：steam.cfg 更新抑制、运行模块、Run/IFEO/SilentProcessExit、代理客观提示；P2：Wallpaper Engine 工坊来源概览；附加：红信 URL 本地判真伪与只读取证 ZIP。" />
                                <TextBlock Margin="0,14,0,0" FontSize="16" FontWeight="SemiBold" Text="仍明确不覆盖" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21" Foreground="#667085"
                                           Text="内核态隐藏、完整历史文件访问审计、libcef 内存逐字节 Hook 比对、所有 Steam 未来版本的运行时 URL 映射，以及对任意压缩包/MP4 的病毒判定。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E5EBED" Padding="14,8">
            <Grid>
                <TextBlock x:Name="FooterStatusText" Foreground="#526572" Text="就绪 · 普通权限运行 · 不常驻后台" />
                <TextBlock x:Name="SteamPathText" HorizontalAlignment="Right" MaxWidth="620" Foreground="#526572" TextTrimming="CharacterEllipsis" Text="正在定位 Steam…" />
            </Grid>
        </Border>
    </Grid>
</Window>
